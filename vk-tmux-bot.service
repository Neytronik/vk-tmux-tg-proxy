[Unit]
Description=VK Tmux Bot — управление tmux через ВКонтакте
After=network.target

[Service]
Type=simple
User=claude
WorkingDirectory=/home/vkbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/vkbot/.venv/bin/python3 /home/vkbot/run.py start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
